<?xml version="1.0" encoding="utf-8"?>
<!-- Parte superior de la pantalla principal: logotipo, imagen de cabecera y resumen del día.
     Se reutiliza con <include> en layout/activity_main.xml y layout-land/activity_main.xml.
     InefficientWeight se ignora porque los anchos con peso usan @dimen/ancho_segun_peso (0dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="InefficientWeight">

    <!-- Cabecera: logotipo, nombre y eslogan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/tamano_logo"
            android:layout_height="@dimen/tamano_logo"
            android:contentDescription="@string/descripcion_logo"
            android:src="@drawable/ic_logo_agendo" />

        <LinearLayout
            android:layout_width="@dimen/ancho_segun_peso"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_grande"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Agendo.Texto.TituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                style="@style/Agendo.Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eslogan" />
        </LinearLayout>
    </LinearLayout>

    <!-- Imagen de cabecera (mapa de bits) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_cabecera"
        android:layout_marginTop="@dimen/espacio_grande"
        android:contentDescription="@string/descripcion_cabecera"
        android:scaleType="centerCrop"
        android:src="@drawable/cabecera_escritorio"
        app:shapeAppearanceOverlay="@style/Agendo.Forma.Redondeada" />

    <!-- Resumen del día -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Agendo.Tarjeta.Resumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_grande">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <TextView
                style="@style/Agendo.Texto.SobrePrimario.Detalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_hoy" />

            <TextView
                android:id="@+id/textoPendientes"
                style="@style/Agendo.Texto.SobrePrimario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_pequeno" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/barraProgreso"
                style="@style/Agendo.BarraProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_grande" />

            <TextView
                android:id="@+id/textoProgreso"
                style="@style/Agendo.Texto.SobrePrimario.Detalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_medio" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
